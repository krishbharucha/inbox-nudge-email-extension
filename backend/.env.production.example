# Template only: provide real values through your host's secret manager.
APP_ENV=production
DEMO_MODE=false
WEB_AUTH_ENABLED=false
REQUEST_LIMITS_ENABLED=true
DELIVERY_WORKER_ENABLED=true
CORS_ORIGINS=
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR_DATABASE_HOST/inbox_nudge?sslmode=verify-full
# Configure sslrootcert in DATABASE_URL when required by your managed DB provider.
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_REAL_API_DOMAIN/api/auth/google/callback
EXTENSION_ID=
# Website push is optional and unnecessary for Chrome extension notifications.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
