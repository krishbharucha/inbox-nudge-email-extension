DATABASE_URL=sqlite:///./inbox-nudge.db
APP_ENV=development
WEB_AUTH_ENABLED=true
REQUEST_LIMITS_ENABLED=true
DEMO_MODE=true
# Local demonstration only. Generate a unique secret before any hosted use.
JWT_SECRET=local-demo-only-change-this-secret-32chars
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Add the unpacked extension ID from chrome://extensions to allow its origin.
EXTENSION_ID=
# Google Cloud OAuth client type: Web application. Never put the secret in the extension.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
WEB_APP_ORIGIN=http://127.0.0.1:5173
# Generate once: ../.venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key stable and backed up; it encrypts stored Google credentials.
TOKEN_ENCRYPTION_KEY=
# Generate once from backend/: ../.venv/bin/python -m app.setup_push
# Keep this pair stable so registered browsers continue to work.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com
DELIVERY_WORKER_ENABLED=true
